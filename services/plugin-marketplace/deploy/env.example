# Production only: replace the reserved example domain with the deployed issuer.
MARKET_OIDC_ISSUER=https://identity.example.invalid/realms/plugins
MARKET_OIDC_JWKS=https://identity.example.invalid/realms/plugins/protocol/openid-connect/certs
MARKET_OIDC_AUDIENCE=lanjian-plugin-market
# Native service (container already supplies these):
MARKET_DATA_DIR=/absolute/persistent/plugin-market
MARKET_HOST=127.0.0.1
MARKET_PORT=43120
# Desktop, through controlled launch/distribution configuration:
LANJIAN_MARKET_ORIGIN=https://plugins.example.invalid
LANJIAN_MARKET_ISSUER=https://identity.example.invalid/realms/plugins
LANJIAN_MARKET_CLIENT_ID=lanjian-desktop
